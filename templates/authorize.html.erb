<form
  method="post"
  action="<%= rodauth.authorize_path %>"
  class="form-horizontal"
  role="form"
  id="authorize-form"
>
  <% if respond_to?(:csrf_tag) %>
    <%= csrf_tag(rodauth.authorize_path) %>
  <% end %>

  <% if rodauth.oauth_application[rodauth.oauth_applications_logo_uri_column] %>
    <img
      alt="oauth application logo"
      src="<%= h(rodauth.oauth_application[rodauth.oauth_applications_logo_uri_column]) %>"
    >
  <% end %>

  <p class="lead">
    <%
      application_uri = rodauth.oauth_application[rodauth.oauth_applications_homepage_url_column]
      application_name = if application_uri
        "<a target=\"_blank\" href=\"#{h(application_uri)}\">" \
         "#{h(rodauth.oauth_application[rodauth.oauth_applications_name_column])}</a>"
      else
        h(rodauth.oauth_application[rodauth.oauth_applications_name_column])
      end
    %>

    <%= rodauth.authorize_page_lead(name: application_name) %>
  </p>

  <div class="list-group">
    <% if rodauth.oauth_application[rodauth.oauth_applications_tos_uri_column] %>
      <a
        class="list-group-item"
        target="_blank"
        href="<%= h(rodauth.oauth_application[rodauth.oauth_applications_tos_uri_column]) %>"
      >
        <%= rodauth.oauth_applications_tos_uri_label %>
      </a>
    <% end %>

    <% if rodauth.oauth_application[rodauth.oauth_applications_policy_uri_column] %>
      <a
        class="list-group-item"
        target="_blank"
        href="<%= h(rodauth.oauth_application[rodauth.oauth_applications_policy_uri_column]) %>"
      >
        <%= rodauth.oauth_applications_policy_uri_label %>
      </a>
    <% end %>
  </div>

  <% if rodauth.oauth_application[rodauth.oauth_applications_contacts_column] %>
    <div class="list-group">
      <h3 class="display-6">
        <%= rodauth.oauth_applications_contacts_label %>
      </h3>

      <% rodauth.oauth_application[rodauth.oauth_applications_contacts_column].split(/ +/).each do |contact| %>
        <div class="list-group-item">
          <%= h(contact) %>
        </div>
      <% end %>
    </div>
  <% end %>

  <div class="form-group">
    <h1 class="display-6"><%= rodauth.oauth_grants_scopes_label %></h1>

    <% rodauth.authorize_scopes.each do |scope| %>
      <% if rodauth.features.include?(:oidc) && scope == "offline_access" %>
        <input type="hidden" name="scope[]" value="<%= h(scope) %>">
      <% else %>
        <div class="form-check">
          <input
            id="<%= scope %>"
            class="form-check-input"
            type="checkbox"
            name="scope[]"
            value="<%= h(scope) %>"
          >

          <label class="form-check-label" for="<%= scope %>"><%= h(scope) %></label>
        </div>
      <% end %>
    <% end %>

    <% rodauth.authorize_form_params.each do |field| %>
      <input
        type="<%= h(field["type"]) %>"
        name="<%= h(field["name"]) %>"
        value="<%= h(field["value"]) %>"
      >
    <% end %>
  </div>

  <p class="text-center">
    <input
      type="submit"
      class="btn btn-outline-primary"
      value="<%= h(rodauth.oauth_authorize_button) %>"
    >

    <%
      redirect_uri = h(rodauth.redirect_uri) +
        "?error=access_denied&error_description=The+resource+owner+or+authorization+server+denied+the+request"
        if rodauth.param_or_nil("state")
          redirect_uri << "&state=#{CGI.escape(rodauth.param("state"))}"
        end
    %>

    <a href="<%= redirect_uri %>" class="btn btn-outline-danger">
      <%= h(rodauth.oauth_cancel_button) %>
    </a>
  </p>
</form>
