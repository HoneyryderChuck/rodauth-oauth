<!DOCTYPE html>

<html>
  <head>
    <title><%= @page_title %></title>

    <meta charset="utf-8">

    <% if content_for? :meta_tags %>
      <%= content_for(:meta_tags) %>
    <% end %>

    <%= csrf_meta_tags %>
  </head>

  <body>
    <% if notice %>
      <p id="notice"><%= notice %></p>
    <% end %>

    <% if alert %>
      <p id="alert"><%= alert %></p>
    <% end %>

    <%= yield %>
  </body>
</html>
